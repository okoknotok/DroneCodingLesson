function createVase(gx, gz, idx) {
  const parent = new BABYLON.TransformNode('vase' + idx, scene);
  parent.position = new BABYLON.Vector3(gx * STEP, 0, gz * STEP);
  const base = BABYLON.MeshBuilder.CreateCylinder('vBase' + idx, { height: 0.15, diameterTop: 0.5, diameterBottom: 0.4 }, scene);
  base.position.y = 0.075; base.parent = parent;
  const body = BABYLON.MeshBuilder.CreateSphere('vBody' + idx, { diameter: 0.85, segments: 16 }, scene);
  body.scaling = new BABYLON.Vector3(1, 1.3, 1);
  body.position.y = 0.7; body.parent = parent;
  const neck = BABYLON.MeshBuilder.CreateCylinder('vNeck' + idx, { height: 0.3, diameterTop: 0.45, diameterBottom: 0.35 }, scene);
  neck.position.y = 1.35; neck.parent = parent;
  const mat = new BABYLON.StandardMaterial('vmat' + idx, scene);
  const blueShade = 0.85 + Math.random() * 0.15;
  mat.diffuseColor = new BABYLON.Color3(blueShade * 0.7, blueShade * 0.85, blueShade);
  mat.specularColor = new BABYLON.Color3(0.4, 0.4, 0.5);
  base.material = mat; body.material = mat; neck.material = mat;
  const flowerColors = [
    new BABYLON.Color3(1, 0.4, 0.6),
    new BABYLON.Color3(1, 0.85, 0.3),
    new BABYLON.Color3(0.9, 0.3, 0.3),
  ];
  for (let i = 0; i < 3; i++) {
    const stem = BABYLON.MeshBuilder.CreateCylinder('stem' + idx + '_' + i, { height: 0.5, diameter: 0.03 }, scene);
    stem.position = new BABYLON.Vector3((Math.random() - 0.5) * 0.2, 1.75, (Math.random() - 0.5) * 0.2);
    stem.rotation.z = (Math.random() - 0.5) * 0.4;
    stem.parent = parent;
    const stemMat = new BABYLON.StandardMaterial('sm' + idx + '_' + i, scene);
    stemMat.diffuseColor = new BABYLON.Color3(0.2, 0.5, 0.15);
    stem.material = stemMat;
    const flower = BABYLON.MeshBuilder.CreateSphere('fl' + idx + '_' + i, { diameter: 0.18, segments: 8 }, scene);
    flower.position = new BABYLON.Vector3(stem.position.x, 2.0, stem.position.z);
    flower.parent = parent;
    const fm = new BABYLON.StandardMaterial('fm' + idx + '_' + i, scene);
    fm.diffuseColor = flowerColors[i % flowerColors.length];
    fm.emissiveColor = flowerColors[i % flowerColors.length].scale(0.15);
    flower.material = fm;
  }
  return parent;
}

function createPlant(gx, gz, idx) {
  const parent = new BABYLON.TransformNode('plant' + idx, scene);
  parent.position = new BABYLON.Vector3(gx * STEP, 0, gz * STEP);
  const pot = BABYLON.MeshBuilder.CreateCylinder('pot' + idx, { height: 0.5, diameterTop: 0.7, diameterBottom: 0.5 }, scene);
  pot.position.y = 0.25; pot.parent = parent;
