  sCtx.fillText('S', 128, 128);
  sTex.update(); sTex.hasAlpha = true;
  const sm = new BABYLON.StandardMaterial('sm', scene);
  sm.diffuseTexture = sTex; sm.diffuseTexture.hasAlpha = true;
  sm.useAlphaFromDiffuseTexture = true;
  sm.specularColor = new BABYLON.Color3(0,0,0);
