<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="UTF-8">
<title>Drone Blockly - 完整版</title>
<script src="https://cdn.babylonjs.com/babylon.js"></script>
<script src="https://unpkg.com/blockly/blockly.min.js"></script>
<script src="https://unpkg.com/blockly/msg/zh-hant.js"></script>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: -apple-system, "PingFang TC", "Microsoft JhengHei", sans-serif; background: #0d1421; color: #fff; overflow: hidden; height: 100vh; }
  
  /* ============== 開始選單 ============== */
  #startMenu {
    position: fixed; inset: 0; z-index: 2000;
    background: radial-gradient(circle at 50% 30%, #1a3458 0%, #0a0f1e 70%);
    display: none; flex-direction: column;
    align-items: center; justify-content: center;
    padding: 20px; overflow-y: auto;
  }
  #startMenu.show { display: flex; }
  #startMenu::before {
    content: ''; position: absolute; inset: 0;
    background-image: 
      radial-gradient(2px 2px at 20% 30%, rgba(255,255,255,0.4), transparent),
      radial-gradient(1px 1px at 60% 70%, rgba(255,255,255,0.3), transparent),
      radial-gradient(2px 2px at 80% 20%, rgba(255,255,255,0.4), transparent),
      radial-gradient(1px 1px at 30% 80%, rgba(255,255,255,0.3), transparent),
      radial-gradient(1px 1px at 90% 50%, rgba(255,255,255,0.4), transparent);
    pointer-events: none;
    animation: twinkle 4s ease-in-out infinite alternate;
  }
  @keyframes twinkle { from { opacity: 0.3; } to { opacity: 1; } }
  
  .menu-content { position: relative; z-index: 1; text-align: center; max-width: 900px; width: 100%; }
  .menu-title {
    font-size: 56px; font-weight: 900; margin-bottom: 8px;
    background: linear-gradient(135deg, #4fc3f7 0%, #FFBF00 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: 4px;
  }
  .menu-emoji { font-size: 64px; margin-bottom: 10px; animation: float 3s ease-in-out infinite; }
  @keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
  .menu-subtitle {
    color: #8da8c8; margin-bottom: 50px; font-size: 18px;
    letter-spacing: 2px;
  }
  .mode-cards {
    display: flex; gap: 30px; flex-wrap: wrap;
    justify-content: center; padding: 0 20px;
  }
  .mode-card {
    background: linear-gradient(160deg, rgba(255,255,255,0.08), rgba(255,255,255,0.02));
    border: 2px solid rgba(79,195,247,0.3);
    border-radius: 24px;
    padding: 36px 28px;
    width: 300px;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    text-align: center;
    backdrop-filter: blur(10px);
    position: relative;
    overflow: hidden;
  }
  .mode-card::before {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(135deg, transparent, rgba(79,195,247,0.1), transparent);
    opacity: 0; transition: opacity 0.3s;
  }
  .mode-card:hover {
    transform: translateY(-8px) scale(1.02);
    border-color: #4fc3f7;
    box-shadow: 0 20px 50px rgba(79,195,247,0.4);
  }
  .mode-card:hover::before { opacity: 1; }
  .mode-card.freeflight { border-color: rgba(255,191,0,0.3); }
  .mode-card.freeflight:hover {
    border-color: #FFBF00;
    box-shadow: 0 20px 50px rgba(255,191,0,0.4);
  }
  .mode-card .card-icon { font-size: 80px; margin-bottom: 18px; display: block; }
  .mode-card h2 { color: #fff; font-size: 26px; margin-bottom: 12px; font-weight: 700; }
  .mode-card p { color: #b0c4de; font-size: 14px; line-height: 1.7; margin-bottom: 18px; }
  .mode-card .card-features {
    display: flex; flex-wrap: wrap; gap: 6px;
    justify-content: center;
  }
  .mode-card .feature-tag {
    font-size: 11px; padding: 4px 10px;
    background: rgba(79,195,247,0.15); color: #4fc3f7;
    border-radius: 10px; border: 1px solid rgba(79,195,247,0.3);
  }
  .mode-card.freeflight .feature-tag {
    background: rgba(255,191,0,0.15); color: #FFBF00;
    border-color: rgba(255,191,0,0.3);
  }
  .menu-footer { color: #5a7090; font-size: 12px; margin-top: 40px; }
  
  /* ============== 主介面 ============== */
  #app { display: flex; height: 100vh; }
  #stage { flex: 1; position: relative; min-width: 300px; }
  #renderCanvas { width: 100%; height: 100%; display: block; touch-action: none; }
  
  #backToMenu {
    position: absolute; top: 12px; left: 50%; transform: translateX(-50%);
    background: rgba(10,18,32,0.92); color: #fff;
    padding: 8px 16px; border-radius: 20px;
    border: 1px solid rgba(79,195,247,0.4);
    cursor: pointer; font-size: 12px; font-weight: 700;
    backdrop-filter: blur(8px); z-index: 6;
    display: flex; align-items: center; gap: 6px;
  }
  #backToMenu:hover { background: rgba(20,40,80,0.95); border-color: #4fc3f7; }
  
  #divider {
    width: 6px; background: #000; cursor: ew-resize; flex-shrink: 0;
    transition: background 0.15s; position: relative; z-index: 50;
  }
  #divider::before {
    content: '⋮⋮'; position: absolute; top: 50%; left: 50%;
    transform: translate(-50%, -50%); color: #4fc3f7; font-size: 14px;
    letter-spacing: -2px; opacity: 0.5; pointer-events: none;
  }
  #divider:hover, #divider.dragging { background: #4fc3f7; }
  #divider:hover::before, #divider.dragging::before { opacity: 1; color: #fff; }
  
  #hud { position: absolute; top: 12px; left: 12px; background: rgba(10,18,32,0.92); padding: 12px 16px; border-radius: 12px; font-size: 13px; line-height: 1.7; backdrop-filter: blur(8px); border: 1px solid rgba(79,195,247,0.3); z-index: 5; }
  #hud .row { display: flex; gap: 12px; align-items: center; }
  #hud .label { color: #888; font-size: 11px; min-width: 60px; }
  #hud .val { color: #4fc3f7; font-weight: 700; font-family: monospace; }
  #hud .status { display: inline-block; padding: 2px 10px; border-radius: 10px; background: #2a3a5a; font-size: 11px; font-weight: 700; }
  #hud .status.flying { background: #50C878; }
  #hud .status.busy { background: #FF8C42; }
  #hud .fail { color: #ff8090; font-size: 11px; margin-top: 4px; }
  #hud .extras { color: #FFD700; font-size: 11px; margin-top: 4px; }
  #hud.freeflight-mode .prog-only { display: none; }
  
  #levelPanel { 
    position: absolute; top: 12px; right: 12px; 
    background: rgba(10,18,32,0.92); 
    border-radius: 12px; backdrop-filter: blur(8px); 
    border: 1px solid rgba(255,191,0,0.4); 
    z-index: 5; width: 330px; 
    max-height: calc(100vh - 24px); 
    overflow: hidden;
    transition: width 0.25s ease, max-height 0.25s ease;
  }
  #levelPanel.collapsed { width: auto; max-height: 44px; }
  
  #lvHeader {
    display: flex; align-items: center; justify-content: space-between;
    padding: 10px 12px; cursor: pointer;
    background: rgba(255,191,0,0.08);
    border-bottom: 1px solid rgba(255,191,0,0.2);
    user-select: none;
  }
  #levelPanel.collapsed #lvHeader { border-bottom: none; }
  #lvHeader:hover { background: rgba(255,191,0,0.15); }
  #lvHeader .lv-title { font-size: 13px; font-weight: 700; color: #FFBF00; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  #lvToggle {
    background: rgba(255,191,0,0.2); border: none; color: #FFBF00;
    width: 24px; height: 24px; border-radius: 6px; cursor: pointer;
    font-size: 14px; font-weight: 700; display: flex; align-items: center; justify-content: center;
    transition: transform 0.25s; flex-shrink: 0; margin-left: 10px;
  }
  #levelPanel.collapsed #lvToggle { transform: rotate(180deg); }
  
  #lvBody { 
    padding: 12px 14px; 
    max-height: calc(100vh - 80px);
    overflow-y: auto;
  }
  #lvBody .lv-desc { font-size: 11.5px; color: #ccc; line-height: 1.55; margin-bottom: 8px; max-height: 110px; overflow-y: auto; }
  #lvBody .lv-goal { font-size: 11.5px; color: #4fc3f7; padding: 6px 8px; background: rgba(79,195,247,0.1); border-radius: 6px; border-left: 3px solid #4fc3f7; line-height: 1.4; }
  #lvBody .lv-nav { display: flex; gap: 5px; margin-top: 8px; }
  #lvBody .lv-nav button { flex: 1; padding: 5px 6px; border: none; border-radius: 6px; background: #2a3a5a; color: #fff; cursor: pointer; font-size: 11px; font-weight: 700; }
  #lvBody .lv-nav button:hover { background: #3a4a6a; }
  #lvBody .lv-nav button:disabled { opacity: 0.4; cursor: not-allowed; }
  #lvBody .lv-nav .next { background: linear-gradient(135deg, #50C878, #3CB371); }
  #lvSelect { width: 100%; margin-top: 6px; padding: 5px; border-radius: 6px; background: #1a2942; color: #fff; border: 1px solid #2a3a5a; font-size: 11px; }
  
  #hintBox { display: none; margin-top: 8px; padding: 8px 10px; background: rgba(255,170,40,0.12); border-left: 3px solid #FFA500; border-radius: 6px; font-size: 11.5px; color: #FFD580; line-height: 1.5; animation: hintIn 0.4s ease; }
  #hintBox.show { display: block; }
  #hintBox .hint-title { font-weight: 700; color: #FFBF00; margin-bottom: 3px; }
  @keyframes hintIn { from { opacity: 0; transform: translateY(-5px); } to { opacity: 1; transform: translateY(0); } }
  
  #ansBtn { width: 100%; margin-top: 8px; padding: 8px; border: none; border-radius: 8px; cursor: pointer; font-size: 12px; font-weight: 700; color: #fff; background: linear-gradient(135deg, #FF6B9D, #C9356B); display: none; align-items: center; justify-content: center; gap: 6px; box-shadow: 0 0 12px rgba(255,107,157,0.5); animation: pulse 1.5s ease-in-out infinite; }
  #ansBtn.show { display: flex; }
  #ansBtn:hover { transform: translateY(-1px); }
  @keyframes pulse { 0%, 100% { box-shadow: 0 0 12px rgba(255,107,157,0.5); } 50% { box-shadow: 0 0 20px rgba(255,107,157,0.9); } }
  
  #minimap { position: absolute; bottom: 12px; right: 12px; background: rgba(10,18,32,0.92); padding: 10px; border-radius: 12px; backdrop-filter: blur(8px); border: 1px solid rgba(79,195,247,0.3); z-index: 5; }
  #minimap canvas { display: block; border-radius: 6px; }
  #minimap .mm-title { font-size: 11px; color: #888; margin-bottom: 6px; text-align: center; font-weight: 700; }
  
  /* ============== 自由飛行控制 ============== */
  #freeControls {
    position: absolute; bottom: 20px; left: 50%; transform: translateX(-50%);
    background: rgba(10,18,32,0.92); padding: 16px 20px;
    border-radius: 16px; backdrop-filter: blur(8px);
    border: 1px solid rgba(255,191,0,0.4);
    z-index: 5; display: none;
  }
  #freeControls.show { display: block; }
  #freeControls .ff-title {
    text-align: center; font-size: 12px; color: #FFBF00;
    margin-bottom: 12px; font-weight: 700; letter-spacing: 1px;
  }
  .ff-pad { display: grid; grid-template-columns: 50px 50px 50px; grid-template-rows: 50px 50px 50px; gap: 6px; justify-content: center; }
  .ff-btn {
    background: linear-gradient(135deg, #2a3a5a, #1a2a4a);
    border: 1px solid #4fc3f7;
    color: #fff; border-radius: 10px;
    font-size: 20px; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: all 0.1s; font-weight: 700;
    user-select: none;
  }
  .ff-btn:hover { background: linear-gradient(135deg, #3a4a6a, #2a3a5a); transform: scale(1.05); }
  .ff-btn:active { transform: scale(0.95); background: #4fc3f7; }
  .ff-btn.special {
    background: linear-gradient(135deg, #FFBF00, #FF8C00);
    border-color: #FFBF00; color: #000; font-size: 11px;
  }
  .ff-btn.special:active { background: #FFD700; }
  .ff-btn.reset {
    background: linear-gradient(135deg, #c84a4a, #a03030);
    border-color: #c84a4a;
  }
  .ff-pad .empty { visibility: hidden; }
  #freeControls .ff-hint {
    margin-top: 10px; font-size: 10px; color: #888;
    text-align: center; line-height: 1.5;
  }
  
  /* ============== 編程區 ============== */
  #blocksArea { width: 540px; display: flex; flex-direction: column; background: #1e1e1e; flex-shrink: 0; min-width: 300px; }
  #blocklyHeader { background: linear-gradient(180deg, #4C97FF, #3373CC); padding: 10px 14px; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 2px 6px rgba(0,0,0,0.3); flex-wrap: wrap; gap: 8px; }
  #blocklyHeader .title { font-weight: 700; font-size: 14px; }
  #blocklyHeader .actions { display: flex; gap: 5px; flex-wrap: wrap; justify-content: flex-end; }
  #blocklyHeader .actions button { padding: 6px 10px; border: none; border-radius: 6px; font-size: 12px; font-weight: 700; color: #fff; cursor: pointer; transition: transform 0.1s; white-space: nowrap; }
  #blocklyHeader .actions button:hover { transform: translateY(-1px); }
  #blocklyHeader .actions button:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }
  .btn-run { background: linear-gradient(135deg, #50C878, #3CB371); }
  .btn-stop { background: linear-gradient(135deg, #c84a4a, #a03030); }
  .btn-reset { background: #2a3a5a; }
  .btn-clear { background: rgba(255,255,255,0.2); }
  
  #blocklyDiv { flex: 1; background: #f9f9f9; }
  .blocklyToolboxDiv { background: #2a2a2a !important; border-right: 1px solid #000 !important; padding: 4px !important; }
  .blocklyTreeRow { padding: 6px 8px !important; margin-bottom: 2px !important; border-radius: 6px !important; height: auto !important; }
  .blocklyTreeRow:hover { background: rgba(255,255,255,0.1) !important; }
  .blocklyTreeLabel { color: #fff !important; font-size: 12px !important; font-weight: 600 !important; }
  
  #toast { position: absolute; bottom: 90px; left: 50%; transform: translateX(-50%); display: flex; flex-direction: column; gap: 6px; align-items: center; pointer-events: none; z-index: 10; }
  .toast-msg { background: rgba(10,18,32,0.95); padding: 8px 16px; border-radius: 20px; font-size: 13px; border: 1px solid rgba(79,195,247,0.4); backdrop-filter: blur(8px); animation: toastIn 0.3s ease, toastOut 0.4s ease 2.6s forwards; }
  .toast-success { border-color: #50C878; color: #a0e8b0; }
  .toast-warn { border-color: #FFA500; color: #FFD580; }
  .toast-error { border-color: #c84a4a; color: #ff9090; }
  @keyframes toastIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes toastOut { to { opacity: 0; transform: translateY(-10px); } }
  
  .modal-overlay { position: absolute; inset: 0; background: rgba(0,0,0,0.7); display: none; align-items: center; justify-content: center; z-index: 100; backdrop-filter: blur(4px); }
  .modal-overlay.show { display: flex; }
  .modal-box { background: linear-gradient(135deg, #1a2942, #0d1421); padding: 30px 40px; border-radius: 16px; border: 2px solid #FFBF00; text-align: center; box-shadow: 0 0 50px rgba(255,191,0,0.3); animation: pop 0.4s ease; max-width: 460px; }
  .modal-box.hint { border-color: #FF6B9D; box-shadow: 0 0 50px rgba(255,107,157,0.3); }
  @keyframes pop { from { transform: scale(0.5); opacity: 0; } to { transform: scale(1); opacity: 1; } }
  .modal-box h2 { color: #FFBF00; font-size: 24px; margin-bottom: 10px; }
  .modal-box.hint h2 { color: #FF6B9D; }
  .modal-box p { color: #ccc; margin-bottom: 20px; line-height: 1.6; font-size: 14px; }
  .modal-btns { display: flex; gap: 10px; justify-content: center; }
  .modal-btns button { padding: 10px 20px; border: none; border-radius: 8px; font-weight: 700; cursor: pointer; font-size: 14px; color: #fff; }
  .next-btn { background: linear-gradient(135deg, #50C878, #3CB371); }
  .stay-btn { background: #2a3a5a; }
  .confirm-btn { background: linear-gradient(135deg, #FF6B9D, #C9356B); }
</style>
</head>
<body>

<!-- ============== 開始選單 ============== -->
<div id="startMenu" class="show">
  <div class="menu-content">
    <div class="menu-emoji">🚁</div>
    <h1 class="menu-title">DRONE LAB</h1>
    <div class="menu-subtitle">無人機編程實驗室</div>
    <div class="mode-cards">
      <div class="mode-card programming" onclick="enterMode('programming')">
        <span class="card-icon">🧩</span>
        <h2>編程模式</h2>
        <p>使用 Blockly 積木編程控制無人機,挑戰 15 個由淺入深的關卡,學習序列、迴圈、條件判斷與感測器邏輯。</p>
        <div class="card-features">
          <span class="feature-tag">📘 15 關</span>
          <span class="feature-tag">🧠 邏輯思維</span>
          <span class="feature-tag">💡 提示系統</span>
        </div>
      </div>
      <div class="mode-card freeflight" onclick="enterMode('freeflight')">
        <span class="card-icon">🕹️</span>
        <h2>自由飛行模式</h2>
        <p>手動操控無人機,自由探索 3D 場景。使用鍵盤 WASD/方向鍵控制,或點擊螢幕按鈕,放鬆放鬆!</p>
        <div class="card-features">
          <span class="feature-tag">⌨️ 鍵盤控制</span>
          <span class="feature-tag">🌐 3D 探索</span>
          <span class="feature-tag">🎮 即時操作</span>
        </div>
      </div>
    </div>
    <div class="menu-footer">© Drone Lab · Powered by Babylon.js + Blockly</div>
  </div>
</div>

<!-- ============== 主介面 ============== -->
<div id="app">
  <div id="stage">
    <canvas id="renderCanvas"></canvas>
    
    <button id="backToMenu" onclick="backToMenu()">🏠 返回選單</button>
    
    <div id="hud">
      <div class="row"><span class="label">位置</span><span class="val">X:<span id="px">0.0</span> Z:<span id="pz">0.0</span></span></div>
      <div class="row"><span class="label">格座標</span><span class="val">(<span id="gx">0</span>, <span id="gz">0</span>)</span></div>
      <div class="row"><span class="label">方向</span><span class="val"><span id="pd">0°</span> <span id="pdn">→東</span></span></div>
      <div class="row prog-only"><span class="label">距終點</span><span class="val"><span id="pdist">--</span> 格</span></div>
      <div class="row"><span class="label">狀態</span><span id="ps" class="status">待機</span></div>
      <div class="extras prog-only" id="extrasInfo" style="display:none"></div>
      <div class="fail prog-only" id="failInfo" style="display:none">失敗次數:<span id="failNum">0</span></div>
    </div>
    
    <div id="levelPanel">
      <div id="lvHeader" onclick="togglePanel()">
        <span class="lv-title">📘 第 <span id="lvNum">1</span> 關:<span id="lvName">--</span></span>
        <button id="lvToggle" title="收起/展開">▼</button>
      </div>
      <div id="lvBody">
        <div class="lv-desc" id="lvDesc">--</div>
        <div class="lv-goal">🎯 <span id="lvGoal">--</span></div>
        <select id="lvSelect" onchange="loadLevel(parseInt(this.value))"></select>
        <div class="lv-nav">
          <button id="lvPrev" onclick="changeLevel(-1)">◀ 上一關</button>
          <button id="lvRestart" onclick="loadLevel(currentLevel)">🔄 重玩</button>
          <button id="lvNext" class="next" onclick="changeLevel(1)">下一關 ▶</button>
        </div>
        <div id="hintBox">
          <div class="hint-title">💡 小提示</div>
          <div id="hintText">--</div>
        </div>
        <button id="ansBtn" onclick="askShowAnswer()">📖 顯示參考答案</button>
      </div>
    </div>
    
    <div id="minimap">
      <div class="mm-title">小地圖(北↑)</div>
      <canvas id="mmCanvas" width="180" height="135"></canvas>
    </div>
    
    <!-- 自由飛行控制面板 -->
    <div id="freeControls">
      <div class="ff-title">🕹️ 自由飛行控制</div>
      <div class="ff-pad">
        <div class="empty"></div>
        <button class="ff-btn" onmousedown="freeMove(1)" ontouchstart="event.preventDefault();freeMove(1)" title="前進 (W/↑)">⬆</button>
        <div class="empty"></div>
        <button class="ff-btn" onmousedown="freeTurn(-90)" ontouchstart="event.preventDefault();freeTurn(-90)" title="左轉 (A/←)">↺</button>
        <button class="ff-btn special" onmousedown="freeToggleFly()" ontouchstart="event.preventDefault();freeToggleFly()" title="起飛/降落 (空白鍵)" id="flyBtn">起飛</button>
        <button class="ff-btn" onmousedown="freeTurn(90)" ontouchstart="event.preventDefault();freeTurn(90)" title="右轉 (D/→)">↻</button>
        <div class="empty"></div>
        <button class="ff-btn" onmousedown="freeMove(-1)" ontouchstart="event.preventDefault();freeMove(-1)" title="後退 (S/↓)">⬇</button>
        <button class="ff-btn reset" onmousedown="freeReset()" ontouchstart="event.preventDefault();freeReset()" title="重置位置">⟳</button>
      </div>
      <div class="ff-hint">⌨️ 鍵盤: W/A/S/D 或方向鍵移動 · Space 起降</div>
    </div>
    
    <div id="toast"></div>
    
    <div id="winModal" class="modal-overlay">
      <div class="modal-box">
        <h2 id="winTitle">🎉 過關!</h2>
        <p id="winMsg">恭喜完成本關!</p>
        <div class="modal-btns">
          <button class="stay-btn" onclick="closeModal('winModal')">留在本關</button>
          <button class="next-btn" id="winNext" onclick="goNextFromModal()">下一關 ▶</button>
        </div>
      </div>
    </div>
    
    <div id="ansModal" class="modal-overlay">
      <div class="modal-box hint">
